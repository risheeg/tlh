{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vault-ingest",
  "main": "src/entry.py",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
    "vars": {
      "R2_INBOX_PREFIX": "inbox/",
      "R2_PROCESSED_PREFIX": "processed/",
      "R2_PARSED_PREFIX": "parsed/",
      "DAILY_NEURON_BUDGET": "9500",
      "AI_STAGE1_MODEL": "gemini-3.5-flash",
      "AI_STAGE2_MODEL": "gemini-3.5-flash",
      "GEMINI_RPM_LIMIT": "15",
      "GEMINI_RPD_LIMIT": "450",
      "GEMINI_STAGE2_RPD_LIMIT": "500",
      // Mistral: classification + extraction via mistral-large-latest (Chat API).
      // OCR model (mistral-ocr-latest) is hardcoded in mistral.py.
      // Gemini vars kept for fallback; set AI_STAGE*_MODEL to gemini-* to switch back.
    },
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "vault-ingest"
    }
  ],
  "d1_databases": [
    {
      "binding": "VAULT_DB",
      "database_name": "vault-ingest",
      "database_id": "25bf8b6d-ee8d-473d-8707-98e3689c8c84",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "queue": "vault-ingest",
        "binding": "VAULT_INGEST"
      }
    ],
    "consumers": [
      {
        "queue": "vault-ingest",
        "max_batch_size": 1,
        "max_batch_timeout": 30,
        // Serialize consumption so the D1-backed Gemini pre-flight (gemini_quota)
        // is race-free; tune GEMINI_RPM_LIMIT / GEMINI_RPD_LIMIT and GEMINI_STAGE2_*.
        "max_concurrency": 1,
        "max_retries": 16,
        "dead_letter_queue": "vault-ingest-dlq"
      }
    ]
  }
}
